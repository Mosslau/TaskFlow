# ===== Java（GitHub 模板，预留给 Spring 后端）=====
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# ===== 项目定制 =====
# macOS
.DS_Store

# 助手工作日志（会话级，不入库）
.workbuddy/memory/

# skills CLI 本地缓存（可由 skills-lock.json 复原，.workbuddy/skills 已含副本）
.agents/

# 依赖与构建产物（前端/通用）
node_modules/
dist/
target/

.cache/

# Maven 工作区级本地仓库（本机 ~/Downloads 下的默认仓库受沙箱限制不可用）
.m2/

# pnpm 存储缓存
.pnpm-store/
# IDE 配置（IntelliJ）
.idea/
