# ============================================================
# TaskFlow M6.3 部署环境变量模板
#
# 用法:
#   1) cp .env.example .env
#   2) 生产环境务必修改所有标注「必改」的项(见 README「安全清单」)
#   3) docker compose 会自动读取 deploy/.env;裸机脚本 scripts/start-all.sh、
#      scripts/backup.sh 也会 source 本文件
#
# 约定:相对路径一律以 deploy/ 目录为基准;密钥只经环境变量注入,绝不写入
#      代码库/镜像(各服务镜像内仅含 jar + JRE,不含任何密钥)。
# ============================================================

# ---- 时区 ----
TZ=Asia/Shanghai

# ---- JWT 密钥(五个服务共用同一份,不一致会导致令牌校验失败,【必改】)----
# 留空时回退到各服务 application.yml 的开发默认值 taskflow-dev-secret-please-override(不安全!)
# 生成强随机值:  openssl rand -base64 48
JWT_SECRET=

# ---- PostgreSQL(【必改】POSTGRES_PASSWORD;生产请用 20+ 位随机串)----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
PGHOST=127.0.0.1
PGPORT=5432

# ---- Redis(【必改】REDIS_PASSWORD)----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=root

# ---- RabbitMQ(【必改】RABBITMQ_PASSWORD;建议同时换掉默认用户名)----
RABBITMQ_USER=taskflow
RABBITMQ_PASSWORD=taskflow
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672

# ---- Nacos 注册中心 ----
# Docker Compose 内部固定使用服务名 nacos:8848(见 docker-compose.yml,不受本项影响);
# 裸机部署时指向本机 Nacos: 默认 127.0.0.1:8848(与各 application.yml 一致)
NACOS_ADDR=127.0.0.1:8848
# v2.4.3 单机默认鉴权关闭(免登录控制台)。生产对外暴露时建议开启:
NACOS_AUTH_ENABLE=false
# NACOS_AUTH_ENABLE=true 时必须填写以下三项(Nacos 2.2.1+ 已移除内置默认值),并给各服务
# 配置注册账号:SPRING_CLOUD_NACOS_DISCOVERY_USERNAME / SPRING_CLOUD_NACOS_DISCOVERY_PASSWORD
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=

# ---- SMTP(notification-service 邮件,可选;本机无 SMTP 时保持默认即可,不会阻断启动)----
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_TIMEOUT=5000
MAIL_FROM=taskflow@example.com

# ---- 附件存储目录(task-service 附件落盘)----
# Docker Compose:容器内固定 /taskflow/attachments,绑定到宿主机 deploy/data/attachments,
#                此处保持默认即可(备份脚本按相对 deploy/ 解析)。
# 裸机:脚本会把相对路径解析到 deploy/ 下,可自行改为绝对路径。
ATTACHMENT_ROOT=./data/attachments

# ---- 备份(backup.sh)----
# BACKUP_ROOT 支持绝对路径或相对 deploy/ 的路径
BACKUP_ROOT=./backups
# 保留最近 N 天滚动(满足 RPO 24h 建议 N>=7,勿小于 1)
BACKUP_KEEP_DAYS=7
